{
  "name": "reserva-hotel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.2.1",
    "typescript": "~6.0.3",

    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "pg": "^8.12.0",
    "tsx": "^4.20.6",
    "vue": "^3.5.44",
    "vue-router": "^5.0.4"
  }
}
